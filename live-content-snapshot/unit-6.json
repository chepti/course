5e9\u05ea \u05de\u05e0\u05d5\u05d9 \u05d1\u05ea\u05e9\u05dc\u05d5\u05dd. <\/strong><a href=\"https:\/\/youtu.be\/GOt1uyZN294\">https:\/\/youtu.be\/GOt1uyZN294<\/a><\/p>"},{"id":"tools_explanation","title":"\u05e1\u05e8\u05d8\u05d5\u05e0\u05d9 \u05d4\u05e1\u05d1\u05e8","parent":"tools","videos":[],"html":"<h2>\u05e1\u05e8\u05d8\u05d5\u05e0\u05d9 \u05d4\u05e1\u05d1\u05e8<\/h2>\r\n                    \r\n                    <hr>\r\n                    \r\n                    <h4>\u05d2'\u05de\u05d9\u05e0\u05d9 \u05e0\u05d5\u05d8\u05d1\u05d5\u05e7<\/h4>\r\n                    <p>\u05d1\u05ea\u05d5\u05da \u05e0\u05d5\u05d8\u05d1\u05d5\u05e7 \u05e0\u05d9\u05ea\u05df \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e1\u05e8\u05d8\u05d5\u05df \u05e1\u05e7\u05d9\u05e8\u05d4, \u05d6\u05d5 \u05d1\u05e2\u05e6\u05dd \u05de\u05e6\u05d2\u05ea \u05de\u05e2\u05d5\u05e6\u05d1\u05ea \u05e9\u05de\u05dc\u05d5\u05d5\u05d4 \u05d1\u05e7\u05e8\u05d9\u05d9\u05e0\u05d5\u05ea, \u05e9\u05de\u05e6\u05d9\u05d2\u05d4 \u05d0\u05ea \u05d4\u05ea\u05d5\u05db\u05df \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d1\u05d4\u05d9\u05e8\u05d4 \u05d5\u05de\u05e2\u05e0\u05d9\u05d9\u05e0\u05ea \u05d9\u05d7\u05e1\u05d9\u05ea.<\/p>\r\n                    <p>[video: https:\/\/www.youtube.com\/embed\/DByAr6q2Uhs]<\/p>\r\n\r\n                    <hr>\r\n                    \r\n                    <h4>\u05e1\u05d9\u05de\u05d5\u05d5\u05dc<\/h4>\r\n                    <p>\u05ea\u05d5\u05e1\u05e3 \u05dc\u05d3\u05e4\u05d3\u05e4\u05df \u05e9\u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05e7\u05d5\u05d1\u05e5 \u05d0\u05d5 \u05e0\u05d5\u05e9\u05d0 \u05d5\u05dc\u05d9\u05e6\u05d5\u05e8 \u05e2\u05dc\u05d9\u05d5 \u05e1\u05e8\u05d8\u05d5\u05df \u05d4\u05e1\u05d1\u05e8. \u05d1\u05e1\u05d9\u05e1\u05d9 \u05de\u05d1\u05d7\u05d9\u05e0\u05ea \u05e2\u05d9\u05e6\u05d5\u05d1, \u05ea\u05d5\u05e6\u05e8 \u05d0\u05e8\u05d5\u05da \u05d9\u05d7\u05e1\u05d9\u05ea (\u05db-5 \u05d3\u05e7\u05d5\u05ea).<\/p>\r\n                    <p>20K \u05ea\u05d5\u05d5\u05d9\u05dd \u05d7\u05d9\u05e0\u05dd \u05d1\u05d7\u05d5\u05d3\u05e9. \u05d0\u05d9\u05df \u05d0\u05d5\u05e4\u05e6\u05d9\u05d4 \u05dc\u05d4\u05d5\u05e8\u05d3\u05ea \u05d4\u05e1\u05e8\u05d8\u05d5\u05df \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4, \u05e6\u05e8\u05d9\u05da \u05dc\u05e6\u05dc\u05dd \u05d1\u05e2\u05d6\u05e8\u05ea \u05db\u05dc\u05d9 \u05d4\u05e7\u05dc\u05d8\u05ea \u05de\u05e1\u05da.<\/p>\r\n                    <div class=\"button-wrapper\">\r\n                        <a href=\"https:\/\/www.symvol.io\/\" target=\"_blank\" class=\"styled-button\" data-track-click>\u05e1\u05d9\u05de\u05d5\u05d5\u05dc<\/a>\r\n                    <\/div>\r\n\r\n                    <hr>\r\n                    \r\n                    <h4>\u05e1\u05e8\u05d8\u05d5\u05df \u05d4\u05e1\u05d1\u05e8 \u05d1\u05e7\u05e0\u05d1\u05d4<\/h4>\r\n                    <p>\u05dc\u05e4\u05e2\u05de\u05d9\u05dd \u05e0\u05e8\u05e6\u05d4 \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e1\u05e8\u05d8\u05d5\u05df \u05d4\u05e1\u05d1\u05e8 \u05d1\u05e2\u05e6\u05de\u05e0\u05d5, \u05d1\u05dc\u05d9 \u05d1\u05d9\u05e0\u05d4.<\/p>\r\n                    <p>\u05e7\u05e0\u05d1\u05d4 \u05dc\u05de\u05e9\u05dc \u05de\u05d0\u05e4\u05e9\u05e8\u05ea \u05dc\u05d4\u05e7\u05dc\u05d9\u05d8 \u05d0\u05ea \u05e2\u05e6\u05de\u05e0\u05d5, \u05e2\u05dd \u05d0\u05d5 \u05d1\u05dc\u05d9 \u05e9\u05d9\u05e8\u05d0\u05d5 \u05d0\u05d5\u05ea\u05e0\u05d5, \u05e2\u05dc \u05d2\u05d1\u05d9 \u05de\u05e6\u05d2\u05d5\u05ea \u05d5\u05d9\u05e6\u05d9\u05e8\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea.<\/p>\r\n                    <p>\u05d0\u05d9\u05da? \u05d1\u05d4\u05e2\u05dc\u05d0\u05d5\u05ea, \u05e0\u05dc\u05d7\u05e5 \u05e2\u05dc \"\u05d4\u05e7\u05dc\u05d8 \u05d0\u05ea \u05e2\u05e6\u05de\u05da\" \u05d5\u05e0\u05d2\u05d9\u05e2 \u05dc\u05e1\u05d8\u05d5\u05d3\u05d9\u05d5. \u05e0\u05d1\u05d7\u05e8 \u05de\u05e1\u05db\u05d9\u05dd \u05dc\u05e9\u05d9\u05ea\u05d5\u05e3, \u05e0\u05de\u05e7\u05dd \u05d0\u05ea \u05d4\u05d5\u05d9\u05d3\u05d0\u05d5 \u05d5\u05e0\u05ea\u05d7\u05d9\u05dc \u05dc\u05d4\u05e7\u05dc\u05d9\u05d8.<\/p>\r\n                    <p>\u05d1\u05e1\u05d9\u05d5\u05dd - \u05e9\u05de\u05d9\u05e8\u05d4 \u05d5\u05d9\u05e6\u05d9\u05d0\u05d4. \u05e7\u05e0\u05d1\u05d4 \u05de\u05d6\u05d4\u05d4 \u05de\u05e2\u05d1\u05e8\u05d9\u05dd \u05d1\u05d9\u05df \u05e9\u05e7\u05e4\u05d9\u05dd, \u05d5\u05de\u05d7\u05dc\u05e7\u05ea \u05d0\u05ea \u05d4\u05d5\u05d9\u05d3\u05d0\u05d5 \u05db\u05da \u05e9\u05d9\u05e6\u05d9\u05d2 \u05d1\u05db\u05dc \u05e9\u05e7\u05e3 \u05e8\u05e7 \u05d0\u05ea \u05d4\u05e7\u05d8\u05e2 \u05d4\u05de\u05ea\u05d0\u05d9\u05dd.<\/p>\r\n                    <p>\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05db\u05ea\u05d5\u05d1\u05d9\u05d5\u05ea \u05dc\u05e1\u05e8\u05d8\u05d5\u05df \u05e9\u05d0\u05e0\u05d5 \u05de\u05e2\u05dc\u05d9\u05dd \u05d0\u05dc \u05e7\u05e0\u05d1\u05d4, \u05d1\u05d0\u05d5\u05e4\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05d9\u05d5\u05d5\u05e6\u05e8\u05d5 \u05ea\u05d9\u05d1\u05d5\u05ea \u05d8\u05e7\u05e1\u05d8 \u05de\u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05dc\u05db\u05dc \u05e7\u05d8\u05e2 \u05d1\u05e1\u05e8\u05d8\u05d5\u05df, \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05e2\u05e8\u05d5\u05da.<\/p>\r\n\r\n                    <hr>\r\n                    \r\n                    <h4>\u05e1\u05e8\u05d8\u05d5\u05df \u05e1\u05de\u05df - \u05e1\u05e7\u05e8\u05d9\u05df\u05e4\u05d0\u05dc<\/h4>\r\n                    <p>\u05db\u05dc\u05d9 \u05d7\u05de\u05d5\u05d3 \u05dc\u05dc\u05db\u05d9\u05d3\u05ea \u05de\u05e1\u05da, \u05d0\u05e0\u05d9 \u05de\u05e9\u05ea\u05de\u05e9\u05ea \u05d1\u05d5 \u05d4\u05de\u05d5\u05df. \u05de\u05d3\u05d2\u05d9\u05e9 \u05d0\u05ea \u05e1\u05de\u05df \u05d4\u05e2\u05db\u05d1\u05e8, \u05de\u05e7\u05dc\u05d9\u05d8 \u05d0\u05d5\u05ea\u05d9 \u05d5\u05d0\u05ea \u05d4\u05de\u05e1\u05da \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d1\u05d4\u05d9\u05e8\u05d4 (\u05e4\u05d7\u05d5\u05ea \u05de\u05d5\u05e6\u05dc\u05d7 \u05db\u05e9\u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05e7\u05dc\u05d9\u05d8 \u05e9\u05de\u05e2 \u05de\u05d4\u05de\u05d7\u05e9\u05d1). \u05d9\u05ea\u05e8\u05d5\u05df \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 - \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05e9\u05d4\u05d5\u05ea \u05d4\u05e7\u05dc\u05d8\u05d4, \u05dc\u05d7\u05d6\u05d5\u05e8 \u05d0\u05d7\u05d5\u05e8\u05e0\u05d9\u05ea \u05d5\u05dc\u05d3\u05e8\u05d5\u05e1 \u05e7\u05d8\u05e2\u05d9\u05dd.<\/p>\r\n                    <p>\u05d7\u05d9\u05e0\u05dd \u05e2\u05d3 15 \u05d3\u05e7\u05d5\u05ea \u05d1\u05db\u05dc \u05e4\u05e2\u05dd, \u05de\u05d0\u05e4\u05e9\u05e8 \u05d7\u05d9\u05d1\u05d5\u05e8 \u05dc\u05e2\u05e8\u05d5\u05e5 \u05d9\u05d5\u05d8\u05d9\u05d5\u05d1 \u05d5\u05d4\u05e2\u05dc\u05d0\u05d4 \u05d9\u05e9\u05d9\u05e8\u05d4 \u05dc\u05e9\u05dd, \u05e2\u05e8\u05d9\u05db\u05d4 \u05d1\u05e1\u05d9\u05e1\u05d9\u05ea<\/p>\r\n                    <p>[video: https:\/\/www.youtube.com\/embed\/j8eljodcbLE]<\/p>\r\n                    <div class=\"button-wrapper\">\r\n                        <a href=\"https:\/\/screenpal.com\/\" target=\"_blank\" class=\"styled-button\" data-track-click>\u05e1\u05e7\u05e8\u05d9\u05df\u05e4\u05d0\u05dc<\/a>\r\n                    <\/div>\r\n\r\n                    <hr>\r\n                    \r\n                    <h4>LOOM<\/h4>\r\n                    <p>\u05e2\u05d5\u05d3 \u05d7\u05dc\u05d5\u05e4\u05d4 \u05e2\u05dd \u05d1\u05d5\u05e0\u05d5\u05e1 \u05dc\u05de\u05d5\u05e8\u05d9\u05dd - LOOM. \u05d4\u05d9\u05ea\u05e8\u05d5\u05df - \u05de\u05e2\u05dc\u05d4 \u05de\u05d9\u05d3 \u05dc\u05e2\u05e0\u05df \u05d0\u05ea \u05d4\u05e1\u05e8\u05d8\u05d5\u05df, \u05d0\u05e4\u05e9\u05e8 \u05dc\u05ea\u05ea \u05e1\u05e8\u05d8\u05d5\u05df \u05e6\u05e4\u05d9\u05d4 \u05ea\u05d5\u05da \u05d3\u05e7\u05d5\u05ea \u05e1\u05e4\u05d5\u05e8\u05d5\u05ea. \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d1\u05e7\u05e9 \u05d7\u05e9\u05d1\u05d5\u05df \u05d7\u05d9\u05e0\u05d5\u05da.<\/p>\r\n                    <div class=\"button-wrapper\">\r\n                        <a href=\"https:\/\/tikshuv.chepti.com\/%D7%90%D7%99%D7%9A-%D7%A4%D7%AA%D7%97%D7%AA%D7%99-%D7%97%D7%A9%D7%91%D7%95%D7%9F-%D7%9C%D7%95%D7%9D-loom-%D7%9C%D7%97%D7%99%D7%A0%D7%95%D7%9A\/\" target=\"_blank\" class=\"styled-button\" data-track-click>LOOM - \u05d7\u05e9\u05d1\u05d5\u05df \u05d7\u05d9\u05e0\u05d5\u05da<\/a>\r\n                    <\/div>"},{"id":"tools_songs","title":"\u05e9\u05d9\u05e8\u05d9\u05dd","parent":"tools","videos":[],"html":"<h4>\u05e9\u05d9\u05e8\u05d9\u05dd\u00a0 \u05d1\u05d2'\u05de\u05d9\u05e0\u05d9<\/h4>\r\n<p>\u05d2'\u05de\u05d9\u05e0\u05d9 2.5 \u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e9\u05d9\u05e8\u05d9\u05dd \u05d5\u05de\u05d5\u05d6\u05d9\u05e7\u05d4, \u05db\u05d5\u05dc\u05dc \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea. \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d1\u05e7\u05e9 \u05d2'\u05d9\u05e0\u05d2\u05dc \u05dc\u05e9\u05d9\u05e2\u05d5\u05e8, \u05e9\u05d9\u05e8 \u05dc\u05e4\u05e8\u05e9\u05ea \u05e9\u05d1\u05d5\u05e2, \u05de\u05e0\u05d2\u05d9\u05e0\u05d4 \u05dc\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05de\u05d9\u05d3\u05e2 \u05d5\u05e2\u05d5\u05d3 - \u05d5\u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05d4\u05e7\u05d5\u05d1\u05e5 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d9\u05e9\u05d9\u05e8 \u05d1\u05db\u05d9\u05ea\u05d4.<\/p>\r\n<p><a href=\"https:\/\/gemini.google.com\/app\"> \u05d2'\u05de\u05d9\u05e0\u05d9<\/a><\/p>\r\n<hr \/>\r\n<h4>\u05e9\u05d9\u05e8\u05d9\u05dd \u05d1\u05e1\u05d5\u05e0\u05d5<\/h4>\r\n<p>\u05e1\u05d5\u05e0\u05d5 - \u05d9\u05d5\u05e6\u05e8 \u05e9\u05d9\u05e8\u05d9\u05dd \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea. \u05e9\u05d9\u05de\u05d5 \u05dc\u05d1: \u05d4\u05d5\u05e8\u05d3\u05ea \u05e9\u05d9\u05e8 \u05de\u05e1\u05d5\u05e0\u05d5 \u05de\u05e6\u05e8\u05d9\u05db\u05d4 \u05de\u05e0\u05d5\u05d9 \u05d1\u05ea\u05e9\u05dc\u05d5\u05dd - \u05d2\u05dd \u05d1\u05d2\u05e8\u05e1\u05d4 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9\u05ea. \u05d1\u05d2\u05e8\u05e1\u05d4 \u05d4\u05d7\u05d9\u05e0\u05de\u05d9\u05ea \u05d0\u05e4\u05e9\u05e8 \u05e8\u05e7 \u05dc\u05d4\u05d0\u05d6\u05d9\u05df. \u05d1\u05d2\u05e8\u05e1\u05d4 \u05d1\u05ea\u05e9\u05dc\u05d5\u05dd \u05d0\u05e4\u05e9\u05e8 \u05d2\u05dd \u05dc\u05d4\u05e2\u05dc\u05d5\u05ea \u05d4\u05e7\u05dc\u05d8\u05d4 \u05d5\u05dc\u05e7\u05d1\u05dc \u05ea\u05d6\u05de\u05d5\u05e8\u05ea \u05de\u05dc\u05d5\u05d5\u05d4, \u05d4\u05d7\u05dc\u05e4\u05ea \u05d4\u05e7\u05d5\u05dc \u05d5\u05e2\u05d5\u05d3.<\/p>\r\n<p>[video: https:\/\/www.youtube.com\/embed\/wfCTHXML_SI]<\/p>\r\n<p><a href=\"https:\/\/suno.com\/discover\">\u05e1\u05d5\u05e0\u05d5<\/a><\/p>"},{"id":"discussion","title":"\u05d3\u05d9\u05d5\u05df","parent":"","videos":[],"html":"<h1>\u05d3\u05d9\u05d5\u05df<\/h1>\r\n                    <p><strong>\u05d7\u05dc\u05d5\u05e4\u05d4 1: \u05d3\u05d9\u05dc\u05de\u05d4 \u05e4\u05d3\u05d2\u05d5\u05d2\u05d9\u05ea<\/strong><\/p>\r\n                    <p>\u05d7\u05e9\u05d1\u05d5 \u05e2\u05dc \u05d9\u05d7\u05d9\u05d3\u05ea \u05dc\u05d9\u05de\u05d5\u05d3 \u05e9\u05d0\u05ea\u05dd \u05de\u05dc\u05de\u05d3\u05d9\u05dd. \u05ea\u05d0\u05e8\u05d5 \u05e0\u05d5\u05e9\u05d0 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05e9\u05e7\u05e9\u05d4 \u05dc\u05d4\u05e1\u05d1\u05d9\u05e8 \u05d1\u05e2\u05dc \u05e4\u05d4 \u05d0\u05d5 \u05d1\u05d8\u05e7\u05e1\u05d8. \u05d0\u05d9\u05d6\u05d4 \u05e1\u05d5\u05d2 \u05ea\u05d5\u05db\u05df \u05de\u05d3\u05d9\u05d4 (\u05d0\u05d5\u05d3\u05d9\u05d5\/\u05d4\u05e1\u05d1\u05e8\/\u05d4\u05e0\u05e4\u05e9\u05d4\/\u05e2\u05dc\u05d9\u05dc\u05ea\u05d9\/\u05de\u05d5\u05e0\u05d8\u05d0\u05d6') \u05d9\u05db\u05d5\u05dc \u05dc\u05e9\u05d3\u05e8\u05d2 \u05d0\u05ea \u05d4\u05d4\u05d5\u05e8\u05d0\u05d4 \u05e9\u05dc\u05d5? \u05dc\u05de\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d4\u05e1\u05d5\u05d2 \u05d4\u05d6\u05d4? \u05de\u05d4 \u05d4\u05e2\u05e8\u05da \u05d4\u05de\u05d5\u05e1\u05e3 \u05e9\u05dc\u05d5 \u05e2\u05dc \u05e4\u05e0\u05d9 \u05d4\u05e1\u05d1\u05e8 \u05de\u05e1\u05d5\u05e8\u05ea\u05d9?<\/p>\r\n                    <p><strong>\u05d7\u05dc\u05d5\u05e4\u05d4 2: \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05db\u05d9\u05d5\u05e6\u05e8\u05d9\u05dd<\/strong><\/p>\r\n                    <p>\u05d0\u05dd \u05d4\u05d9\u05d9\u05ea\u05dd \u05e0\u05d5\u05ea\u05e0\u05d9\u05dd \u05dc\u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd \u05e9\u05dc\u05db\u05dd \u05de\u05e9\u05d9\u05de\u05d4 \u05dc\u05d9\u05e6\u05d5\u05e8 \u05ea\u05d5\u05db\u05df \u05de\u05d3\u05d9\u05d4 \u05e2\u05dc \u05e0\u05d5\u05e9\u05d0 \u05e9\u05dc\u05de\u05d3\u05d5 - \u05d0\u05d9\u05d6\u05d4 \u05e1\u05d5\u05d2 \u05ea\u05d5\u05db\u05df \u05d4\u05d9\u05d9\u05ea\u05dd \u05d1\u05d5\u05d7\u05e8\u05d9\u05dd? \u05d1\u05d0\u05d9\u05d6\u05d5 \u05e9\u05db\u05d1\u05ea \u05d2\u05d9\u05dc? \u05de\u05d4 \u05d4\u05dc\u05de\u05d9\u05d3\u05d4 \u05d4\u05e2\u05de\u05d5\u05e7\u05d4 \u05e9\u05ea\u05ea\u05e8\u05d7\u05e9 \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d9\u05e6\u05d9\u05e8\u05d4 \u05e2\u05e6\u05de\u05d5 (\u05de\u05e2\u05d1\u05e8 \u05dc\u05d9\u05d3\u05e2 \u05e2\u05dc \u05d4\u05e0\u05d5\u05e9\u05d0)?<\/p>\r\n                    \r\n                    <img src=\"https:\/\/i.imgur.com\/wI5ovIv.jpg\" alt=\"\u05d0\u05d9\u05d5\u05e8 \u05d3\u05d9\u05d5\u05df\" class=\"illustration\">"},{"id":"task","title":"\u05de\u05e9\u05d9\u05de\u05d4","parent":"","videos":[],"html":"<h1>\u05de\u05e9\u05d9\u05de\u05d4<\/h1>\r\n<p>\u05e6\u05e8\u05d5 \u05ea\u05d5\u05db\u05df \u05de\u05d3\u05d9\u05d4 \u05d0\u05d7\u05d3 \u05e9\u05d9\u05e9\u05e8\u05ea \u05de\u05d5\u05e8\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd:<\/p>\r\n<h4>\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea 1: \u05e1\u05e8\u05d8\u05d5\u05df \u05d4\u05e1\u05d1\u05e8 (2-4 \u05d3\u05e7\u05d5\u05ea)<\/h4>\r\n<p>\u05d4\u05e1\u05d1\u05e8 \u05e7\u05e6\u05e8 \u05e2\u05dc \u05e0\u05d5\u05e9\u05d0 \u05dc\u05d9\u05de\u05d5\u05d3\u05d9 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 - \u05de\u05d5\u05e9\u05d2 \u05de\u05ea\u05de\u05d8\u05d9, \u05ea\u05d4\u05dc\u05d9\u05da \u05de\u05d3\u05e2\u05d9, \u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9. \u05d1\u05d7\u05e8\u05d5 \u05e0\u05d5\u05e9\u05d0 \u05e9\u05de\u05d5\u05e8\u05d9\u05dd \u05e8\u05d1\u05d9\u05dd \u05de\u05dc\u05de\u05d3\u05d9\u05dd \u05d5\u05d4\u05db\u05d9\u05e0\u05d5 \u05e1\u05e8\u05d8\u05d5\u05df \u05d1\u05e8\u05d5\u05e8 \u05d5\u05de\u05e1\u05d5\u05d3\u05e8.<\/p>\r\n<h4>\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea 2: \u05d3\u05de\u05d5\u05ea \u05de\u05d3\u05d1\u05e8\u05ea<\/h4>\r\n<p>\u05ea\u05de\u05d5\u05e0\u05d4 \u05de\u05d5\u05e0\u05e4\u05e9\u05ea \u05e9\u05dc \u05d3\u05de\u05d5\u05ea \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9\u05ea (\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05ea\/\u05e1\u05e4\u05e8\u05d5\u05ea\u05d9\u05ea\/\u05de\u05d3\u05e2\u05d9\u05ea) \u05e9\u05de\u05e1\u05e4\u05e8\u05ea \u05e2\u05dc \u05e2\u05e6\u05de\u05d4 \u05d0\u05d5 \u05de\u05e1\u05d1\u05d9\u05e8\u05d4 \u05de\u05d5\u05e9\u05d2. \u05d4\u05e7\u05e4\u05d9\u05d3\u05d5 \u05e2\u05dc \u05d3\u05d9\u05d5\u05e7 \u05ea\u05d5\u05db\u05e0\u05d9 \u05d5\u05d0\u05d5\u05ea\u05e0\u05d8\u05d9\u05d5\u05ea.<\/p>\r\n<h4>\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea 3: \u05e4\u05d5\u05d3\u05e7\u05d0\u05e1\u05d8 \u05d7\u05d9\u05e0\u05d5\u05db\u05d9<\/h4>\r\n<p>\u05e9\u05d9\u05d7\u05d4 \u05d0\u05d5 \u05d4\u05e1\u05d1\u05e8 \u05de\u05d5\u05e7\u05dc\u05d8 (3-5 \u05d3\u05e7\u05d5\u05ea) \u05e2\u05dc \u05e0\u05d5\u05e9\u05d0 \u05de\u05e2\u05e0\u05d9\u05d9\u05df. \u05d9\u05db\u05d5\u05dc \u05dc\u05d4\u05d9\u05d5\u05ea \u05e1\u05e7\u05d9\u05e8\u05d4, \u05e8\u05d0\u05d9\u05d5\u05df \u05de\u05d3\u05d5\u05de\u05d4, \u05d0\u05d5 \u05d4\u05e6\u05d2\u05ea \u05e0\u05d5\u05e9\u05d0 \u05d1\u05de\u05d1\u05d8 \u05d7\u05d3\u05e9. (\u05d0\u05dd \u05d1\u05d7\u05e8\u05ea\u05dd \u05e4\u05d5\u05d3\u05e7\u05d0\u05e1\u05d8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 - \u05e6\u05d9\u05d9\u05e0\u05d5 \u05d1\u05e4\u05d5\u05e1\u05d8 \u05db\u05d9\u05e6\u05d3 \u05d4\u05ea\u05d0\u05de\u05ea\u05dd \u05d5\u05d1\u05d3\u05e7\u05ea\u05dd \u05d0\u05ea \u05d0\u05d9\u05db\u05d5\u05ea \u05d4\u05ea\u05d5\u05e6\u05e8)<\/p>\r\n<h4>\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea 4: \u05e1\u05e8\u05d8\u05d5\u05df \u05e2\u05dc\u05d9\u05dc\u05ea\u05d9 \u05e7\u05e6\u05e8<\/h4>\r\n<p>\u05e1\u05d9\u05e4\u05d5\u05e8 \u05d0\u05d5 \u05e1\u05e6\u05e0\u05d4 \u05e9\u05de\u05de\u05d7\u05d9\u05e9\u05d4 \u05e8\u05e2\u05d9\u05d5\u05df \u05dc\u05d9\u05de\u05d5\u05d3\u05d9 - \u05de\u05e9\u05dc, \u05d0\u05d2\u05d3\u05d4, \u05e8\u05d2\u05e2 \u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9. \u05d4\u05e7\u05e4\u05d9\u05d3\u05d5 \u05e2\u05dc \u05d0\u05d9\u05db\u05d5\u05ea \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9\u05ea \u05d5\u05e2\u05dc \u05e7\u05e9\u05e8 \u05d1\u05e8\u05d5\u05e8 \u05dc\u05ea\u05d5\u05db\u05df \u05d4\u05dc\u05d9\u05de\u05d5\u05d3\u05d9.<\/p>\r\n<hr \/>\r\n<h4>\u05de\u05d4 \u05dc\u05d4\u05d2\u05d9\u05e9:<\/h4>\r\n<ul>\r\n<li>\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05ea\u05d5\u05e6\u05e8 \u05d4\u05e1\u05d5\u05e4\u05d9 (\u05e1\u05e8\u05d8\u05d5\u05df\/\u05d0\u05d5\u05d3\u05d9\u05d5) - \u05dc\u05d5\u05d5\u05d3\u05d0 \u05e9\u05e0\u05d2\u05d9\u05e9 \u05dc\u05e6\u05e4\u05d9\u05d4.<\/li>\r\n<li>\u05d1\u05e4\u05d5\u05e1\u05d8 \u05e4\u05e8\u05d8\u05d5:\r\n<ul>\r\n<li>\u05d0\u05d9\u05d6\u05d4 \u05e1\u05d5\u05d2 \u05ea\u05d5\u05db\u05df \u05d1\u05d7\u05e8\u05ea\u05dd \u05d5\u05dc\u05de\u05d4<\/li>\r\n<li>\u05dc\u05d0\u05d9\u05d6\u05d4 \u05e0\u05d5\u05e9\u05d0 \u05dc\u05d9\u05de\u05d5\u05d3\u05d9 \u05d5\u05e9\u05db\u05d1\u05ea \u05d2\u05d9\u05dc \u05d6\u05d4 \u05de\u05ea\u05d0\u05d9\u05dd (\u05d1\u05d7\u05e8\u05d5 \u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05d5\u05ea\u05d2\u05d9\u05d5\u05ea)<\/li>\r\n<li>\u05d1\u05d0\u05d9\u05d6\u05d4 \u05db\u05dc\u05d9 \u05d4\u05e9\u05ea\u05de\u05e9\u05ea\u05dd (\"\u05e4\u05dc\u05d8\u05e4\u05d5\u05e8\u05de\u05d4\")<\/li>\r\n<li>\u05de\u05d4 \u05d4\u05d9\u05d4 \u05de\u05d0\u05ea\u05d2\u05e8 \u05d5\u05de\u05d4 \u05d4\u05e4\u05ea\u05d9\u05e2 \u05d0\u05ea\u05db\u05dd<\/li>\r\n<li>\u05d4\u05e6\u05e2\u05d5\u05ea \u05e9\u05d9\u05de\u05d5\u05e9 \u05e4\u05d3\u05d2\u05d5\u05d2\u05d9 - \u05d0\u05d9\u05da \u05de\u05d5\u05e8\u05d9\u05dd \u05d9\u05db\u05d5\u05dc\u05d9\u05dd \u05dc\u05e9\u05dc\u05d1 \u05d0\u05ea \u05d6\u05d4 \u05d1\u05e9\u05d9\u05e2\u05d5\u05e8<\/li>\r\n<\/ul>\r\n<\/li>\r\n<li>\u05d4\u05e2\u05dc\u05d0\u05d4 \u05dc\u05de\u05d0\u05d2\u05e8 \u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7 - \u05e9\u05ea\u05e4\u05d5 \u05d0\u05ea \u05d4\u05ea\u05d5\u05e6\u05e8 \u05e9\u05dc\u05db\u05dd \u05db\u05d3\u05d9 \u05e9\u05de\u05d5\u05e8\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd \u05d9\u05d5\u05db\u05dc\u05d5 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d5.<\/li>\r\n<\/ul>\r\n<p><strong>\u05d8\u05d9\u05e4:<\/strong> \u05d1\u05d7\u05e8\u05d5 \u05e0\u05d5\u05e9\u05d0 \u05e9\u05d0\u05ea\u05dd \u05de\u05dc\u05de\u05d3\u05d9\u05dd \u05d0\u05d5 \u05e9\u05d0\u05ea\u05dd \u05de\u05db\u05d9\u05e8\u05d9\u05dd \u05d4\u05d9\u05d8\u05d1 - \u05d0\u05d9\u05db\u05d5\u05ea \u05d4\u05ea\u05d5\u05db\u05df \u05d7\u05e9\u05d5\u05d1\u05d4 \u05dc\u05d0 \u05e4\u05d7\u05d5\u05ea \u05de\u05d4\u05d8\u05db\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4.<\/p>\r\n<div class=\"button-wrapper\"><a class=\"styled-button\" href=\"https:\/\/openstuff.co.il\/\" target=\"_blank\" rel=\"noopener\" data-track-click=\"\">\u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7<\/a><\/div>\r\n<div class=\"button-wrapper\"><a class=\"styled-button\" href=\"https:\/\/openstuff.co.il\/upload\/\" target=\"_blank\" rel=\"noopener\" data-track-click=\"\">\u05d0\u05d9\u05da \u05de\u05e2\u05dc\u05d9\u05dd \u05dc\u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7? \u05de\u05d3\u05e8\u05d9\u05da, \u05e1\u05e8\u05d8\u05d5\u05df \u05d5\u05e9\u05d0\u05dc\u05d5\u05ea \u05e0\u05e4\u05d5\u05e6\u05d5\u05ea<\/a><label style=\"display: flex;align-items: center;gap: 10px;cursor: pointer;font-weight: bold\"><\/label><\/div>\r\n<p>[done-button: \u05d4\u05e2\u05dc\u05d9\u05ea\u05d9 \u05dc\u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7]<\/p>"}],"blocked_url":"https:\/\/drive.google.com\/drive\/folders\/1mi_n-dRCTs-h5ZoTTlBimQa0Pf7inDuS?usp=sharing"}
