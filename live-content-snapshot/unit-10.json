<\/li>\n<li>\u05d1\u05d5\u05d3\u05e7\u05d9\u05dd \u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05d1-Workspace \u05d5\u05d1\u05db\u05e1\u05e4\u05ea \u05dc\u05e4\u05e0\u05d9 \u05e9\u05e0\u05d5\u05ea\u05e0\u05d9\u05dd \u05d2\u05d9\u05e9\u05d4 \u05dc\u05e7\u05d1\u05e6\u05d9\u05dd<\/li>\n<li>\u05de\u05d5\u05e1\u05d9\u05e4\u05d9\u05dd \u05d0\u05e0\u05e9\u05d9 \u05e7\u05e9\u05e8 \u05de\u05d5\u05e8\u05e9\u05d9\u05dd \u05d1\u05db\u05d5\u05d5\u05e0\u05d4, \u05d5\u05dc\u05d0 \u05e1\u05ea\u05dd<\/li>\n<li>\u05dc\u05d0 \u05de\u05e2\u05d1\u05d9\u05e8\u05d9\u05dd \u05dc\u05e1\u05d5\u05db\u05df \u05e9\u05de\u05d5\u05ea \u05d0\u05d5 \u05e4\u05e8\u05d8\u05d9\u05dd \u05de\u05d6\u05d4\u05d9\u05dd \u05e9\u05dc \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd<\/li>\n<li>\u05d9\u05d5\u05d3\u05e2\u05d9\u05dd \u05de\u05e8\u05d0\u05e9 \u05d0\u05d9\u05da \u05de\u05ea\u05e0\u05ea\u05e7\u05d9\u05dd \u05d5\u05de\u05d5\u05d7\u05e7\u05d9\u05dd \u05d7\u05e9\u05d1\u05d5\u05df, \u05d5\u05de\u05d4 \u05e0\u05e9\u05d0\u05e8 \u05d0\u05d7\u05e8\u05d9 \u05d6\u05d4<\/li>\n<\/ul>\n<\/div>"},{"id":"tools_recipes","title":"\u05de\u05ea\u05db\u05d5\u05e0\u05d9\u05dd \u05dc\u05de\u05d5\u05e8\u05d4","parent":"tools","videos":[],"html":"<h2>\u05de\u05ea\u05db\u05d5\u05e0\u05d9\u05dd \u05dc\u05de\u05d5\u05e8\u05d4<\/h2>\n<p><strong>\u05d0\u05d7\u05e8\u05d9 \u05e9\u05d4\u05ea\u05d7\u05d1\u05e8\u05e0\u05d5, \u05dc\u05d0 \u05e6\u05e8\u05d9\u05da \u05dc\u05d4\u05de\u05e6\u05d9\u05d0 \u05e4\u05e8\u05d5\u05de\u05e4\u05d8\u05d9\u05dd \u05de\u05d0\u05e4\u05e1. \u05d1\u05e1\u05e4\u05e8\u05d9\u05d9\u05d4 \"\u05de\u05ea\u05db\u05d5\u05e0\u05d9\u05dd \u05dc\u05de\u05d5\u05e8\u05d4 \u05e2\u05dd \u05d0\u05d9\u05e0\u05e1\u05d8\u05d9\u05e0\u05e7\u05d8\" \u05de\u05d7\u05db\u05d9\u05dd \u05e4\u05e8\u05d5\u05de\u05e4\u05d8\u05d9\u05dd \u05de\u05d5\u05db\u05e0\u05d9\u05dd \u05dc\u05d4\u05e2\u05ea\u05e7\u05d4, \u05e8\u05d5\u05d1\u05dd \u05de\u05ea\u05d5\u05da \u05e9\u05d9\u05de\u05d5\u05e9\u05d9\u05dd \u05d0\u05de\u05d9\u05ea\u05d9\u05d9\u05dd \u05e9\u05dc \u05de\u05d5\u05e8\u05d9\u05dd \u05d1\u05e7\u05d4\u05d9\u05dc\u05d4.<\/strong><\/p>\n<div class=\"button-wrapper\"><a class=\"styled-button\" href=\"https:\/\/chepti.com\/instinct\/\" target=\"_blank\" rel=\"noopener\" data-track-click=\"\">\u05dc\u05e1\u05e4\u05e8\u05d9\u05d9\u05ea \u05d4\u05de\u05ea\u05db\u05d5\u05e0\u05d9\u05dd<\/a><\/div>\n<h4>\u05e9\u05dc\u05d5\u05e9\u05d4 \u05e6\u05e2\u05d3\u05d9\u05dd<\/h4>\n<ol>\n<li>\u05d1\u05d5\u05d7\u05e8\u05d9\u05dd \u05de\u05ea\u05db\u05d5\u05df \u05e9\u05de\u05ea\u05d0\u05d9\u05dd \u05dc\u05de\u05e9\u05d9\u05de\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05e9\u05dc\u05db\u05dd<\/li>\n<li>\u05de\u05de\u05dc\u05d0\u05d9\u05dd \u05d0\u05ea \u05d4\u05e9\u05d3\u05d5\u05ea \u05d4\u05de\u05e1\u05d5\u05de\u05e0\u05d9\u05dd \u05d1\u05e1\u05d5\u05d2\u05e8\u05d9\u05d9\u05dd \u05de\u05e8\u05d5\u05d1\u05e2\u05d9\u05dd, \u05db\u05de\u05d5 [\u05e0\u05d5\u05e9\u05d0]<\/li>\n<li>\u05e9\u05d5\u05dc\u05d7\u05d9\u05dd \u05dc\u05d0\u05d9\u05e0\u05e1\u05d8\u05d9\u05e0\u05e7\u05d8, \u05d1\u05d5\u05d3\u05e7\u05d9\u05dd \u05d0\u05ea \u05d4\u05ea\u05d5\u05e6\u05d0\u05d4 \u05d5\u05de\u05ea\u05e7\u05e0\u05d9\u05dd \u05d1\u05e9\u05d9\u05d7\u05d4<\/li>\n<\/ol>\n<h4>\u05de\u05d4 \u05d9\u05e9 \u05d1\u05e1\u05e4\u05e8\u05d9\u05d9\u05d4<\/h4>\n<p>\u05d4\u05de\u05ea\u05db\u05d5\u05e0\u05d9\u05dd \u05de\u05d7\u05d5\u05dc\u05e7\u05d9\u05dd \u05dc\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea: \u05d4\u05d5\u05e8\u05d0\u05d4, \u05d5\u05d9\u05d3\u05d0\u05d5, \u05e2\u05d9\u05e6\u05d5\u05d1, \u05e4\u05d9\u05ea\u05d5\u05d7, \u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4, \u05de\u05d7\u05e7\u05e8 \u05d5\u05e6\u05d5\u05d5\u05ea. \u05dc\u05db\u05dc \u05de\u05ea\u05db\u05d5\u05df \u05d9\u05e9 \u05e8\u05de\u05d4: \u05d1\u05e1\u05d9\u05e1\u05d9, \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9 \u05d0\u05d5 \u05de\u05ea\u05e7\u05d3\u05dd. \u05de\u05ea\u05db\u05d5\u05df \u05e9\u05de\u05e1\u05d5\u05de\u05df \"\u05d8\u05e8\u05dd \u05e0\u05d5\u05e1\u05d4\" \u05e0\u05db\u05ea\u05d1 \u05d1\u05dc\u05d9 \u05e0\u05d9\u05e1\u05d5\u05d9 \u05d1\u05e4\u05d5\u05e2\u05dc, \u05d0\u05d6 \u05db\u05d3\u05d0\u05d9 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05d0\u05d5\u05ea\u05d5 \u05d1\u05e2\u05d9\u05e0\u05d9\u05d9\u05dd \u05e4\u05e7\u05d5\u05d7\u05d5\u05ea.<\/p>\n<hr \/>\n<h4>\u05d3\u05d5\u05d2\u05de\u05d4: \u05d3\u05e3 \u05e2\u05d1\u05d5\u05d3\u05d4 \u05e0\u05e7\u05d9 \u05dc\u05d4\u05d3\u05e4\u05e1\u05d4, \u05de\u05ea\u05de\u05d5\u05e0\u05d4 \u05e9\u05dc \u05d4\u05d9\u05e9\u05df<\/h4>\n<p>\u05e6\u05d9\u05dc\u05de\u05ea\u05dd \u05d3\u05e3 \u05e2\u05d1\u05d5\u05d3\u05d4 \u05d9\u05e9\u05df \u05d5\u05e1\u05e8\u05d5\u05e7? \u05d4\u05e1\u05d5\u05db\u05df \u05d1\u05d5\u05e0\u05d4 \u05d0\u05d5\u05ea\u05d5 \u05de\u05d7\u05d3\u05e9 \u05db\u05d3\u05e3 A4 \u05de\u05d5\u05db\u05df \u05dc\u05d4\u05d3\u05e4\u05e1\u05d4. \u05db\u05da \u05e0\u05e8\u05d0\u05d4 \u05d4\u05de\u05ea\u05db\u05d5\u05df, \u05d5\u05d4\u05e1\u05d5\u05d2\u05e8\u05d9\u05d9\u05dd \u05d4\u05dd \u05d4\u05de\u05e7\u05d5\u05dd \u05e9\u05dc\u05db\u05dd \u05dc\u05d4\u05e9\u05dc\u05d9\u05dd:<\/p>\n[prompt]\u05de\u05e6\u05d5\u05e8\u05e3 \u05e6\u05d9\u05dc\u05d5\u05dd \u05e9\u05dc \u05d3\u05e3 \u05e2\u05d1\u05d5\u05d3\u05d4 [\u05e0\u05d5\u05e9\u05d0]. \u05d1\u05e0\u05d4 \u05d0\u05d5\u05ea\u05d5 \u05de\u05d7\u05d3\u05e9, \u05d0\u05dc \u05ea\u05d7\u05d3\u05d3 \u05d0\u05ea \u05d4\u05e1\u05e8\u05d9\u05e7\u05d4, \u05db\u05d3\u05e3 A4 \u05dc\u05d0\u05d5\u05e8\u05da \u05d0\u05d5 \u05dc\u05e8\u05d5\u05d7\u05d1 \u05de\u05d5\u05db\u05df \u05dc\u05d4\u05d3\u05e4\u05e1\u05d4: \u05e9\u05d7\u05d5\u05e8\u05be\u05dc\u05d1\u05df \u05d1\u05dc\u05d1\u05d3 \u05d1\u05dc\u05d9 \u05d2\u05d5\u05d5\u05e0\u05d9\u05dd \u05d0\u05e4\u05d5\u05e8\u05d9\u05dd, \u05e9\u05d5\u05dc\u05d9\u05d9\u05dd \u05e0\u05d3\u05d9\u05d1\u05d9\u05dd, \u05d0\u05d9\u05d5\u05e8\u05d9\u05dd \u05de\u05e6\u05d5\u05d9\u05e8\u05d9\u05dd \u05d1\u05d9\u05d3 \u05d1\u05e1\u05d2\u05e0\u05d5\u05df \u05d6\u05d5\u05e8\u05dd (\u05dc\u05d0 \u05d0\u05d9\u05d9\u05e7\u05d5\u05e0\u05d9\u05dd \u05d2\u05d0\u05d5\u05de\u05d8\u05e8\u05d9\u05d9\u05dd) \u05e9\u05d0\u05e4\u05e9\u05e8 \u05dc\u05e6\u05d1\u05d5\u05e2. \n\u05d4\u05e1\u05e8 \u05ea\u05d5\u05d5\u05d9\u05d5\u05ea \u05de\u05d9\u05d5\u05ea\u05e8\u05d5\u05ea. \u05d5\u05d3\u05d0 \u05e9\u05db\u05dc \u05d3\u05d5\u05d2\u05de\u05d4 \u05de\u05dc\u05de\u05d3\u05ea \u05d0\u05ea \u05d4\u05d4\u05d1\u05d7\u05e0\u05d4 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d7\u05d3\u05be\u05de\u05e9\u05de\u05e2\u05d9\u05ea \u05d5\u05e9\u05d0\u05d9\u05df \u05d3\u05d5\u05d2\u05de\u05d4 \u05e2\u05dd \u05e9\u05ea\u05d9 \u05ea\u05e9\u05d5\u05d1\u05d5\u05ea \u05d0\u05e4\u05e9\u05e8\u05d9\u05d5\u05ea. \u05d1\u05d3\u05d5\u05e7 \u05e9\u05e1\u05d9\u05de\u05e0\u05d9 \u05e4\u05d9\u05e1\u05d5\u05e7 \u05e2\u05d1\u05e8\u05d9\u05d9\u05dd (\u05db\u05de\u05d5 \u05e1\u05d9\u05de\u05df \u05e9\u05d0\u05dc\u05d4) \u05d1\u05db\u05d9\u05d5\u05d5\u05df \u05d4\u05e0\u05db\u05d5\u05df. \u05e9\u05dc\u05d7 \u05dc\u05d9 \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8.[\/prompt]\n<hr \/>\n<h4>\u05e2\u05d5\u05d3 \u05db\u05de\u05d4 \u05dc\u05d8\u05e2\u05d9\u05de\u05d4<\/h4>\n<ul>\n<li>\u05ea\u05de\u05dc\u05d5\u05dc \u05d5\u05e1\u05d9\u05db\u05d5\u05dd \u05e9\u05dc \u05de\u05e4\u05d2\u05e9 \u05d0\u05d5 \u05d5\u05d5\u05d1\u05d9\u05e0\u05e8 (\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9)<\/li>\n<li>\u05e1\u05e8\u05d8\u05d5\u05df \u05d4\u05e1\u05d1\u05e8 \u05e7\u05e6\u05e8, \u05d1\u05e9\u05dc\u05d1\u05d9\u05dd: \u05ea\u05e1\u05e8\u05d9\u05d8, \u05ea\u05de\u05d5\u05e0\u05d5\u05ea, \u05e8\u05e0\u05d3\u05e8 (\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9)<\/li>\n<li>\u05e7\u05e8\u05d9\u05d0\u05ea \u05e7\u05d5\u05dc \u05e7\u05d5\u05e8\u05d0 \u05d5\u05d4\u05de\u05dc\u05e6\u05d4 \u05e2\u05dc \u05de\u05e1\u05dc\u05d5\u05dc \u05d4\u05d2\u05e9\u05d4 (\u05d1\u05e1\u05d9\u05e1\u05d9)<\/li>\n<li>\u05d4\u05ea\u05e8\u05d0\u05d4 \u05d1\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4 \u05db\u05e9\u05de\u05e9\u05d4\u05d5 \u05de\u05e9\u05ea\u05e0\u05d4 \u05d1\u05d0\u05ea\u05e8 \u05d0\u05d5 \u05d1\u05de\u05e1\u05de\u05da (\u05d1\u05d9\u05e0\u05d5\u05e0\u05d9)<\/li>\n<li>\u05d1\u05d3\u05d9\u05e7\u05ea \u05e9\u05d2\u05d9\u05d0\u05d5\u05ea \u05d1\u05e1\u05e4\u05e8 \u05dc\u05d9\u05de\u05d5\u05d3 (\u05de\u05ea\u05e7\u05d3\u05dd)<\/li>\n<\/ul>\n<p><strong>\u05e9\u05d9\u05de\u05d5 \u05dc\u05d1:<\/strong> \u05d2\u05dd \u05d1\u05de\u05ea\u05db\u05d5\u05e0\u05d9\u05dd, \u05dc\u05d0 \u05de\u05e2\u05dc\u05d9\u05dd \u05dc\u05e1\u05d5\u05db\u05df \u05e9\u05de\u05d5\u05ea \u05d0\u05d5 \u05e4\u05e8\u05d8\u05d9\u05dd \u05de\u05d6\u05d4\u05d9\u05dd \u05e9\u05dc \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd.<\/p>"},{"id":"tools_apps","title":"\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d5\u05ea \u05d1\u05e7\u05d5\u05d3 \u05e4\u05ea\u05d5\u05d7","parent":"tools","videos":[],"html":"<h2>\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d5\u05ea \u05d1\u05e7\u05d5\u05d3 \u05e4\u05ea\u05d5\u05d7 - \u05dc\u05d4\u05e2\u05ea\u05e7\u05d4<\/h2>\n<p><strong>\u05e1\u05d5\u05db\u05df \u05d0\u05d9\u05e9\u05d9 \u05dc\u05d0 \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d1\u05e0\u05d5\u05ea \u05d4\u05db\u05d5\u05dc \u05de\u05d0\u05e4\u05e1. \u05d4\u05d5\u05d0 \u05d9\u05d5\u05d3\u05e2 \u05dc\u05e7\u05d7\u05ea \u05e7\u05d5\u05d3 \u05e4\u05ea\u05d5\u05d7 \u05e9\u05de\u05d9\u05e9\u05d4\u05d5 \u05db\u05d1\u05e8 \u05d1\u05e0\u05d4, \u05dc\u05d4\u05e2\u05ea\u05d9\u05e7 \u05d0\u05d5\u05ea\u05d5 \u05d5\u05dc\u05d4\u05ea\u05d0\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5 \u05dc\u05e6\u05e8\u05db\u05d9\u05dd \u05e9\u05dc\u05e0\u05d5. \u05db\u05d0\u05df \u05db\u05de\u05d4 \u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d5\u05ea \u05d0\u05de\u05d9\u05ea\u05d9\u05d5\u05ea \u05e9\u05e0\u05d1\u05e0\u05d5 \u05d1\u05e2\u05d6\u05e8\u05ea \u05e1\u05d5\u05db\u05e0\u05d9 \u05e7\u05d5\u05d3, \u05d5\u05d1\u05d7\u05dc\u05e7\u05df \u05d4\u05e7\u05d5\u05d3 \u05e4\u05ea\u05d5\u05d7 \u05dc\u05d4\u05e2\u05ea\u05e7\u05d4.<\/strong><\/p>\n<h4>\u05e8\u05d2\u05e2, \u05de\u05d4 \u05d6\u05d4 \u05d2\u05d9\u05d8\u05d4\u05d0\u05d1?<\/h4>\n<p>\u05e7\u05d5\u05d3 \u05e4\u05ea\u05d5\u05d7 \u05e0\u05e9\u05de\u05e8 \u05d5\u05de\u05e9\u05d5\u05ea\u05e3 \u05d1\u05d2\u05d9\u05d8\u05d4\u05d0\u05d1. \u05d4\u05e1\u05e8\u05d8\u05d5\u05df \u05d4\u05e7\u05e6\u05e8 \u05de\u05e1\u05d1\u05d9\u05e8 \u05de\u05d4 \u05d6\u05d4 \u05d5\u05de\u05d4 \u05e2\u05d5\u05e9\u05d9\u05dd \u05e9\u05dd, \u05db\u05d3\u05d9 \u05e9\u05e0\u05d3\u05e2 \u05de\u05d4 \u05dc\u05d1\u05e7\u05e9 \u05de\u05d4\u05e1\u05d5\u05db\u05df \u05db\u05e9\u05e8\u05d5\u05e6\u05d9\u05dd \u05dc\u05d4\u05e2\u05ea\u05d9\u05e7 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8. \u05d4\u05d5\u05d0 \u05e7\u05e6\u05ea \u05d9\u05d5\u05ea\u05e8 \u05de\u05ea\u05e7\u05d3\u05dd, \u05d0\u05d6 \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d3\u05dc\u05d2 \u05e2\u05dc\u05d9\u05d5 \u05d5\u05dc\u05d7\u05d6\u05d5\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05d0\u05d7\u05e8 \u05db\u05da.<\/p>\n<p>[video: https:\/\/www.youtube.com\/embed\/vD_3grnk_o8 | \u05de\u05d4 \u05d6\u05d4 \u05d2\u05d9\u05d8\u05d4\u05d0\u05d1??]<\/p>\n<hr \/>\n<h4>\u05e1\u05d9\u05d5\u05e8 \u05d1\u05d0\u05ea\u05e8 \u05e2\u05e5 \u05de\u05e9\u05e4\u05d7\u05d4 - \u05e7\u05d5\u05d3 \u05e4\u05ea\u05d5\u05d7 \u05dc\u05d4\u05e2\u05ea\u05e7\u05d4<\/h4>\n<p>[video: https:\/\/www.youtube.com\/embed\/BgfwZk_3MHA | \u05e1\u05d9\u05d5\u05e8 \u05d1\u05d0\u05ea\u05e8 \u05e2\u05e5 \u05de\u05e9\u05e4\u05d7\u05d4 - \u05e7\u05d5\u05d3 \u05e4\u05ea\u05d5\u05d7 \u05dc\u05d4\u05e2\u05ea\u05e7\u05d4]<\/p>\n<h4>\u05d4\u05e0\u05d1\u05d7\u05e8\u05ea - \u05e1\u05d1\u05d9\u05d1\u05d4 \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05dc\u05de\u05d9\u05d3\u05d4 \u05d1\u05e6\u05d5\u05d5\u05ea \u05d7\u05d3\u05e8 \u05d4\u05de\u05d5\u05e8\u05d9\u05dd<\/h4>\n<p>[video: https:\/\/www.youtube.com\/embed\/rP3UyWsIBTQ | \u05d4\u05e0\u05d1\u05d7\u05e8\u05ea - \u05e1\u05d1\u05d9\u05d1\u05d4 \u05dc\u05e0\u05d9\u05d4\u05d5\u05dc \u05dc\u05de\u05d9\u05d3\u05d4 \u05d1\u05e6\u05d5\u05d5\u05ea \u05d7\u05d3\u05e8 \u05d4\u05de\u05d5\u05e8\u05d9\u05dd]<\/p>\n<h4>\u05db\u05dc\u05d9 \u05de\u05dc\u05d5\u05d5\u05d4 \u05dc\u05d4\u05d5\u05e8\u05d0\u05ea \u05d9\u05d6\u05de\u05d5\u05ea<\/h4>\n<p>[video: https:\/\/www.youtube.com\/embed\/iTdcHhZoqNo | \u05db\u05dc\u05d9 \u05de\u05dc\u05d5\u05d5\u05d4 \u05dc\u05d4\u05d5\u05e8\u05d0\u05ea \u05d9\u05d6\u05de\u05d5\u05ea]<\/p>\n<h4>\u05e9\u05d3\u05e8\u05d2\u05e0\u05d5 \u05d0\u05ea \u05e1\u05d1\u05d9\u05d1\u05ea \u05d4\u05dc\u05de\u05d9\u05d3\u05d4 \u05e2\u05dd wilk - \u05dc\u05e7\u05e8\u05d5\u05d0 \u05d0\u05e0\u05d2\u05dc\u05d9\u05ea<\/h4>\n<p>[video: https:\/\/www.youtube.com\/embed\/djUttB6SWKw | \u05e9\u05d3\u05e8\u05d2\u05e0\u05d5 \u05d0\u05ea \u05e1\u05d1\u05d9\u05d1\u05ea \u05d4\u05dc\u05de\u05d9\u05d3\u05d4 \u05e2\u05dd wilk - \u05dc\u05e7\u05e8\u05d5\u05d0 \u05d0\u05e0\u05d2\u05dc\u05d9\u05ea!]<\/p>\n<h4>\u05db\u05dc\u05d9 \u05e9\u05d9\u05d1\u05d5\u05e5 \u05dc\u05d7\u05d5\u05d3\u05e9 \u05d4\u05d1\u05d9\u05e0\u05d4<\/h4>\n<p>[video: https:\/\/www.youtube.com\/embed\/WNSbc8uOYP4 | \u05db\u05dc\u05d9 \u05e9\u05d9\u05d1\u05d5\u05e5 \u05dc\u05d7\u05d5\u05d3\u05e9 \u05d4\u05d1\u05d9\u05e0\u05d4]<\/p>"},{"id":"help_tools","title":"\u05db\u05dc\u05d9 \u05e2\u05d6\u05e8","parent":"tools","videos":[],"html":"<h2>\u05db\u05dc\u05d9 \u05e2\u05d6\u05e8<\/h2>\n<h4>\u05d4\u05e1\u05e4\u05e8\u05d9\u05d9\u05d4 \u05d2\u05d3\u05dc\u05d4 \u05d1\u05d6\u05db\u05d5\u05ea\u05db\u05dd<\/h4>\n<p>\u05d2\u05d9\u05dc\u05d9\u05ea\u05dd \u05de\u05ea\u05db\u05d5\u05df \u05e9\u05e2\u05d5\u05d1\u05d3 \u05de\u05e6\u05d5\u05d9\u05df? \u05d1\u05d0\u05ea\u05e8 \u05d4\u05e1\u05e4\u05e8\u05d9\u05d9\u05d4 \u05d9\u05e9 \u05d8\u05d5\u05e4\u05e1 \"\u05d4\u05d2\u05e9\u05ea \u05de\u05ea\u05db\u05d5\u05df\": \u05de\u05de\u05dc\u05d0\u05d9\u05dd \u05e9\u05dd, \u05e1\u05d5\u05d2 \u05de\u05e9\u05d9\u05de\u05d4, \u05e8\u05de\u05d4, \u05d4\u05ea\u05d5\u05e6\u05d0\u05d4 \u05d4\u05e6\u05e4\u05d5\u05d9\u05d4 \u05d5\u05d4\u05e4\u05e8\u05d5\u05de\u05e4\u05d8, \u05d5\u05d4\u05de\u05ea\u05db\u05d5\u05df \u05de\u05ea\u05e4\u05e8\u05e1\u05dd \u05d0\u05d7\u05e8\u05d9 \u05e9\u05d0\u05e0\u05d9 \u05e2\u05d5\u05d1\u05e8\u05ea \u05e2\u05dc\u05d9\u05d5. \u05d9\u05e9 \u05e9\u05dd \u05d2\u05dd \u05d8\u05d5\u05e4\u05e1 \u05de\u05e9\u05d5\u05d1 \u05dc\u05d3\u05d9\u05d5\u05d5\u05d7 \u05e2\u05dc \u05ea\u05e7\u05dc\u05d4 \u05d0\u05d5 \u05d4\u05e6\u05e2\u05d4.<\/p>\n<div class=\"button-wrapper\"><a class=\"styled-button\" href=\"https:\/\/chepti.com\/instinct\/\" target=\"_blank\" rel=\"noopener\" data-track-click=\"\">\u05dc\u05e1\u05e4\u05e8\u05d9\u05d9\u05ea \u05d4\u05de\u05ea\u05db\u05d5\u05e0\u05d9\u05dd<\/a><\/div>"},{"id":"discussion","title":"\u05d3\u05d9\u05d5\u05df","parent":"","videos":[],"html":"<h1>\u05d3\u05d9\u05d5\u05df<\/h1>\n<p><strong>\u05d7\u05dc\u05d5\u05e4\u05d4 \u05d0:<\/strong> \u05d0\u05d9\u05d6\u05d5 \u05de\u05e9\u05d9\u05de\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea \u05d1\u05e2\u05d1\u05d5\u05d3\u05d4 \u05e9\u05dc\u05db\u05dd \u05d4\u05d9\u05d9\u05ea\u05dd \u05e9\u05de\u05d7\u05d9\u05dd \u05e9\u05e1\u05d5\u05db\u05df \u05d9\u05e2\u05e9\u05d4 \u05d1\u05de\u05e7\u05d5\u05de\u05db\u05dd? \u05dc\u05de\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05d4\u05d9\u05d0?<\/p>\n<p><strong>\u05d7\u05dc\u05d5\u05e4\u05d4 \u05d1:<\/strong> \u05de\u05d4 \u05d4\u05d9\u05d4 \u05de\u05d3\u05d0\u05d9\u05d2 \u05d0\u05ea\u05db\u05dd \u05d1\u05dc\u05ea\u05ea \u05dc\u05e1\u05d5\u05db\u05df \u05d2\u05d9\u05e9\u05d4, \u05d5\u05de\u05d4 \u05d4\u05d9\u05d9\u05ea\u05dd \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05e8\u05d2\u05d9\u05e9 \u05d1\u05d8\u05d5\u05d7\u05d9\u05dd?<\/p>\n<p><strong>\u05d7\u05dc\u05d5\u05e4\u05d4 \u05d2:<\/strong> \u05e0\u05d9\u05e1\u05d9\u05ea\u05dd \u05de\u05ea\u05db\u05d5\u05df \u05de\u05d4\u05e1\u05e4\u05e8\u05d9\u05d9\u05d4? \u05de\u05d4 \u05e2\u05d1\u05d3 \u05d5\u05de\u05d4 \u05e6\u05e8\u05d9\u05da \u05dc\u05ea\u05e7\u05df?<\/p>\n<p>\u05de\u05d5\u05d6\u05de\u05e0\u05d9\u05dd \u05dc\u05d4\u05d2\u05d9\u05d1 \u05dc\u05e2\u05de\u05d9\u05ea \u05d0\u05d7\u05d3.<\/p>"},{"id":"task","title":"\u05de\u05e9\u05d9\u05de\u05d4","parent":"","videos":[],"html":"<h1>\u05de\u05e9\u05d9\u05de\u05d4<\/h1>\n<p><strong>\u05de\u05d8\u05e8\u05d4: \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05e1\u05d5\u05db\u05df \u05e2\u05dc \u05de\u05e9\u05d9\u05de\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05de\u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 \u05e9\u05dc\u05db\u05dd, \u05d5\u05dc\u05d4\u05d5\u05e1\u05d9\u05e3 \u05dc\u05e1\u05e4\u05e8\u05d9\u05d9\u05d4 \u05d0\u05ea \u05de\u05d4 \u05e9\u05dc\u05de\u05d3\u05ea\u05dd.<\/strong><\/p>\n<h4>\u05de\u05d4 \u05e2\u05d5\u05e9\u05d9\u05dd<\/h4>\n<ol>\n<li>\u05de\u05ea\u05d7\u05d1\u05e8\u05d9\u05dd \u05dc\u05d0\u05d9\u05e0\u05e1\u05d8\u05d9\u05e0\u05e7\u05d8 \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d1\u05d8\u05d5\u05d7\u05d4, \u05dc\u05e4\u05d9 \u05d4\u05e1\u05e8\u05d8\u05d5\u05df \u05d5\u05d4\u05db\u05dc\u05dc\u05d9\u05dd<\/li>\n<li>\u05d1\u05d5\u05d7\u05e8\u05d9\u05dd \u05de\u05ea\u05db\u05d5\u05df \u05d0\u05d7\u05d3 \u05de\u05d4\u05e1\u05e4\u05e8\u05d9\u05d9\u05d4, \u05e2\u05d3\u05d9\u05e3 \u05d1\u05e8\u05de\u05d4 \u05d1\u05e1\u05d9\u05e1\u05d9\u05ea, \u05e9\u05de\u05ea\u05d0\u05d9\u05dd \u05dc\u05de\u05e9\u05d9\u05de\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05e9\u05dc\u05db\u05dd<\/li>\n<li>\u05de\u05e8\u05d9\u05e6\u05d9\u05dd \u05d0\u05d5\u05ea\u05d5, \u05d1\u05d5\u05d3\u05e7\u05d9\u05dd \u05d0\u05ea \u05d4\u05ea\u05d5\u05e6\u05d0\u05d4 \u05d5\u05de\u05ea\u05e7\u05e0\u05d9\u05dd \u05d1\u05e9\u05d9\u05d7\u05d4 \u05e2\u05dd \u05d4\u05e1\u05d5\u05db\u05df \u05e2\u05d3 \u05e9\u05d4\u05d9\u05d0 \u05de\u05ea\u05d0\u05d9\u05de\u05d4<\/li>\n<li>\u05e8\u05d5\u05e9\u05de\u05d9\u05dd \u05de\u05d4 \u05e2\u05d1\u05d3, \u05de\u05d4 \u05e4\u05d7\u05d5\u05ea, \u05d5\u05de\u05d4 \u05d4\u05d9\u05d9\u05ea\u05dd \u05de\u05e9\u05e0\u05d9\u05dd \u05d1\u05de\u05ea\u05db\u05d5\u05df<\/li>\n<\/ol>\n<h4>\u05de\u05d4 \u05de\u05d2\u05d9\u05e9\u05d9\u05dd<\/h4>\n<p>\u05e4\u05d5\u05e1\u05d8 \u05e2\u05dd \u05e9\u05dd \u05d4\u05de\u05ea\u05db\u05d5\u05df, \u05de\u05d4 \u05e9\u05dc\u05d7\u05ea\u05dd \u05dc\u05e1\u05d5\u05db\u05df, \u05e7\u05d9\u05e9\u05d5\u05e8 \u05d0\u05d5 \u05ea\u05de\u05d5\u05e0\u05d4 \u05e9\u05dc \u05d4\u05ea\u05d5\u05e6\u05e8 (\u05d1\u05dc\u05d9 \u05e4\u05e8\u05d8\u05d9\u05dd \u05de\u05d6\u05d4\u05d9\u05dd \u05e9\u05dc \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd), \u05d5\u05de\u05d4 \u05dc\u05de\u05d3\u05ea\u05dd.<\/p>\n<p><strong>\u05d1\u05d5\u05e0\u05d5\u05e1:<\/strong> \u05e9\u05dc\u05d7\u05d5 \u05de\u05ea\u05db\u05d5\u05df \u05d7\u05d3\u05e9 \u05d3\u05e8\u05da \u05d4\u05d8\u05d5\u05e4\u05e1 \u05d1\u05e1\u05e4\u05e8\u05d9\u05d9\u05d4, \u05d5\u05d4\u05d5\u05d0 \u05d9\u05ea\u05e4\u05e8\u05e1\u05dd \u05d0\u05d7\u05e8\u05d9 \u05d0\u05d9\u05e9\u05d5\u05e8.<\/p>\n<p>\u05d0\u05dd \u05d4\u05ea\u05d5\u05e6\u05e8 \u05de\u05ea\u05d0\u05d9\u05dd \u05dc\u05e9\u05d9\u05ea\u05d5\u05e3, \u05d4\u05e2\u05dc\u05d5 \u05d0\u05d5\u05ea\u05d5 \u05dc\u05de\u05d0\u05d2\u05e8 \u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7.<\/p>\n<div class=\"button-wrapper\"><a class=\"styled-button\" href=\"https:\/\/openstuff.co.il\/\" target=\"_blank\" rel=\"noopener\" data-track-click=\"\">\u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7<\/a><\/div>\n[done-button: \u05d4\u05e2\u05dc\u05d9\u05ea\u05d9 \u05dc\u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7]\n<p><a class=\"styled-button\" href=\"https:\/\/openstuff.co.il\/upload\/\" target=\"_blank\" rel=\"noopener\" data-track-click=\"\">\u05d0\u05d9\u05da \u05de\u05e2\u05dc\u05d9\u05dd \u05dc\u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7? \u05de\u05d3\u05e8\u05d9\u05da, \u05e1\u05e8\u05d8\u05d5\u05df \u05d5\u05e9\u05d0\u05dc\u05d5\u05ea \u05e0\u05e4\u05d5\u05e6\u05d5\u05ea<\/a><\/p>"}],"blocked_url":""}
