05dc\u05d3\u05e2\u05ea \u05e9\u05e9\u05d9\u05dc\u05d1\u05e0\u05d5 \u05d1\u05d9\u05e0\u05d4?<\/li>\r\n                           <li>\u05d4\u05d2\u05d9\u05d1\u05d5 \u05dc\u05d7\u05d6\u05d5\u05df \u05e9\u05dc \u05e2\u05de\u05d9\u05ea \u05d0\u05d7\u05d3.<\/li>\r\n                        <\/ul>\r\n                        <img src=\"https:\/\/i.imgur.com\/wd3ivlG.jpg\" alt=\"\u05d0\u05d9\u05dc\u05d5\u05e1\u05d8\u05e8\u05e6\u05d9\u05d4\" class=\"illustration\">"},{"id":"assignment","title":"\u05de\u05e9\u05d9\u05de\u05d4","parent":"","videos":[],"html":"<h1>\u05de\u05e9\u05d9\u05de\u05d4:<\/h1>\r\n<p><strong>\u05d4\u05d7\u05dc\u05e7 \u05d4\u05de\u05e2\u05e9\u05d9 \u05e9\u05dc \u05d4\u05d4\u05e9\u05ea\u05dc\u05de\u05d5\u05ea \u05de\u05d0\u05e4\u05e9\u05e8 \u05d4\u05ea\u05e0\u05e1\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05ea \u05d1\u05d9\u05e6\u05d9\u05e8\u05ea \u05db\u05dc\u05d9 \u05d4\u05e2\u05e8\u05db\u05d4 \u05d1\u05e2\u05d6\u05e8\u05ea AI. \u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05db\u05d5\u05dc\u05dc\u05ea \u05d9\u05e6\u05d9\u05e8\u05ea \u05de\u05d2\u05d5\u05d5\u05df \u05e8\u05db\u05d9\u05d1\u05d9 \u05d4\u05e2\u05e8\u05db\u05d4, \u05d4\u05d7\u05dc \u05de\u05de\u05d1\u05d7\u05e0\u05d9\u05dd \u05d5\u05e2\u05d3 \u05e8\u05d5\u05d1\u05e8\u05d9\u05e7\u05d5\u05ea, \u05ea\u05d5\u05da \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05db\u05dc\u05d9\u05dd \u05e9\u05d4\u05db\u05e8\u05e0\u05d5. \u05d7\u05e9\u05d5\u05d1 \u05d1\u05de\u05d9\u05d5\u05d7\u05d3 \u05dc\u05e9\u05ea\u05e3 \u05d0\u05ea \u05d4\u05e4\u05e8\u05d5\u05de\u05e4\u05d8\u05d9\u05dd \u05e9\u05e9\u05d9\u05de\u05e9\u05d5 \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05d4\u05d7\u05d5\u05de\u05e8\u05d9\u05dd, \u05db\u05da \u05e9\u05db\u05d5\u05dc\u05dd \u05d9\u05d5\u05db\u05dc\u05d5 \u05dc\u05dc\u05de\u05d5\u05d3 \u05de\u05d4\u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d4\u05de\u05e9\u05d5\u05ea\u05e3.<\/strong><\/p>\r\n<h3>\u05e9\u05ea\u05e4\u05d5 \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05e8\u05db\u05d4 \u05e9\u05d1\u05e0\u05d9\u05ea\u05dd \u05d1\u05e2\u05d6\u05e8\u05ea \u05d1\u05d9\u05e0\u05d4:<\/h3>\r\n<p>\u05e6\u05e8\u05d5 \u05de\u05e1\u05de\u05da \u05d5\u05e9\u05ea\u05e4\u05d5 \u05d0\u05ea \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e6\u05e4\u05d9\u05d9\u05d4.<\/p>\r\n<p><strong>\u05d1\u05ea\u05d5\u05da \u05d4\u05de\u05e1\u05de\u05da - \u05d4\u05d2\u05d9\u05e9\u05d5 \u05dc\u05e4\u05d7\u05d5\u05ea 3 \u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05e9\u05d1\u05e0\u05d9\u05ea\u05dd \u05d1\u05e2\u05d6\u05e8\u05ea \u05d1\u05d9\u05e0\u05d4, \u05e6\u05e8\u05e4\u05d5 \u05e4\u05e8\u05d5\u05de\u05e4\u05d8\u05d9\u05dd \u05d5\u05e6\u05d9\u05d9\u05e0\u05d5 \u05d1\u05d0\u05d9\u05d6\u05d4 \u05db\u05dc\u05d9:<\/strong><\/p>\r\n<ul>\r\n<li><strong>\u05e1\u05d8 \u05d4\u05e2\u05e8\u05db\u05d4 \u05d7\u05dc\u05d5\u05e4\u05d9\u05ea:<\/strong> \u05db\u05e8\u05d8\u05d9\u05e1\u05d9 \u05d9\u05e6\u05d9\u05d0\u05d4, \u05de\u05e9\u05d9\u05de\u05ea \u05d4\u05e2\u05e8\u05db\u05d4 \u05d7\u05dc\u05d5\u05e4\u05d9\u05ea, \u05de\u05d7\u05d5\u05d5\u05df \u05de\u05e4\u05d5\u05e8\u05d8, \u05d8\u05d5\u05e4\u05e1 \u05d4\u05e2\u05e8\u05db\u05d4 \u05e2\u05e6\u05de\u05d9\u05ea.<\/li>\r\n<li><strong>\u05e1\u05d8 \u05de\u05d1\u05d7\u05df:<\/strong> \u05d1\u05e0\u05e7 \u05e9\u05d0\u05dc\u05d5\u05ea \u05d1\u05d3\u05e8\u05d2\u05d5\u05ea \u05e7\u05d5\u05e9\u05d9 \u05e9\u05d5\u05e0\u05d5\u05ea, \u05e1\u05d9\u05db\u05d5\u05dd \u05d9\u05d7\u05d9\u05d3\u05ea \u05dc\u05d9\u05de\u05d5\u05d3, \u05de\u05d1\u05d7\u05df\/\u05de\u05d1\u05d3\u05e7 \u05e2\u05dd \u05d4\u05e0\u05d7\u05d9\u05d5\u05ea, \u05e6'\u05e7\u05dc\u05d9\u05e1\u05d8 \u05de\u05d5\u05ea\u05d0\u05dd \u05d0\u05d9\u05e9\u05d9\u05ea.<\/li>\r\n<\/ul>\r\n<div class=\"video-container\">\r\n<div class=\"button-wrapper\"><a class=\"styled-button\" href=\"https:\/\/openstuff.co.il\/\" target=\"_blank\" rel=\"noopener\" data-track-click=\"\">\u05de\u05d0\u05d2\u05e8 \u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7<\/a><\/div>\r\n<div>[done-button: \u05d4\u05e2\u05dc\u05d9\u05ea\u05d9 \u05dc\u05d7\u05d5