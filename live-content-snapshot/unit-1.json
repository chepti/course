9\u05d9\u05dc\u05d5\u05d1 \u05db\u05dc \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd: \u05db\u05dc \u05d4\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05dc\u05e4\u05e2\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea, \u05e1\u05e8\u05d8\u05d5\u05e0\u05d9\u05dd \u05d5\u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05de\u05d4\u05de\u05e1\u05de\u05da \u05d4\u05de\u05e7\u05d5\u05e8\u05d9 \u05e9\u05d5\u05dc\u05d1\u05d5 \u05db\u05e7\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd \u05d1\u05ea\u05d5\u05da \u05d4\u05d8\u05e7\u05e1\u05d8 \u05d0\u05d5 \u05d1\u05d7\u05dc\u05d5\u05e0\u05d9\u05d5\u05ea \u05d4\u05de\u05d9\u05d3\u05e2 \u05d4\u05e6\u05e4\u05d5\u05ea (Tooltips).\r\n\r\n\u05d0\u05e8\u05d2\u05d5\u05df \u05de\u05d7\u05d3\u05e9 \u05e2\u05dd \u05d0\u05e7\u05d5\u05e8\u05d3\u05d9\u05d5\u05e0\u05d9\u05dd \u05de\u05e7\u05d5\u05e0\u05e0\u05d9\u05dd: \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05de\u05d5\u05d3\u05d3 \u05e2\u05dd \u05db\u05de\u05d5\u05ea \u05d4\u05de\u05d9\u05d3\u05e2, \u05d0\u05e8\u05d2\u05e0\u05ea\u05d9 \u05d0\u05ea \u05d4\u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05d4\u05de\u05d5\u05e8\u05db\u05d1\u05d9\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05d0\u05e7\u05d5\u05e8\u05d3\u05d9\u05d5\u05e0\u05d9\u05dd \u05d1\u05ea\u05d5\u05da \u05d0\u05e7\u05d5\u05e8\u05d3\u05d9\u05d5\u05e0\u05d9\u05dd. \u05d6\u05d4 \u05de\u05d0\u05e4\u05e9\u05e8 \u05dc\u05db\u05dd \u05dc\u05d7\u05e9\u05d5\u05e3 \u05d0\u05ea \u05d4\u05de\u05d9\u05d3\u05e2 \u05d1\u05d4\u05d3\u05e8\u05d2\u05d4 \u05d5\u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05e1\u05d3\u05e8 \u05d5\u05d1\u05d4\u05d9\u05e8\u05d5\u05ea.<\/pre>\r\n                    <\/div>\r\n                    <div class=\"button-wrapper\">\r\n                      <a href=\"https:\/\/openstuff.co.il\/2506\/\" target=\"_blank\" class=\"styled-button\" data-track-click>\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05ea\u05d5\u05e6\u05e8 \u05dc\u05d3\u05d5\u05d2\u05de\u05d4<\/a>\r\n                    <\/div>"},{"id":"tools_screen_share","tit