de\u05e6\u05d0\u05d9\u05dd \u05de\u05d5\u05dc\u05e0\u05d5, \u05d4\u05e6\u05e2\u05d5\u05ea \u05dc\u05ea\u05d9\u05e7\u05d5\u05df \u05d5\u05d4\u05e1\u05d1\u05e8\u05d9\u05dd.<\/p>"},{"id":"help_tools","title":"\u05db\u05dc\u05d9 \u05e2\u05d6\u05e8","parent":"tools_intro","videos":[],"html":""},{"id":"help_tools_learning_paths","title":"\u05e2\u05d5\u05d3 \u05d0\u05e4\u05d9\u05e7\u05d9 \u05dc\u05de\u05d9\u05d3\u05d4","parent":"help_tools","videos":[],"html":"<h2>\u05e2\u05d5\u05d3 \u05d0\u05e4\u05d9\u05e7\u05d9 \u05dc\u05de\u05d9\u05d3\u05d4<\/h2>\r\n                    <h4>\u05de\u05e6\u05d2\u05ea \u05d4\u05de\u05e4\u05d2\u05e9<\/h4>\r\n                    <div style=\"position: relative;width: 100%;height: 0;padding-top: 56.2500%;padding-bottom: 0;margin-top: 1.6em;margin-bottom: 0.9em;overflow: hidden;border-radius: 8px\">\r\n                      <iframe loading=\"lazy\" style=\"position: absolute;width: 100%;height: 100%;top: 0;left: 0;border: none;padding: 0;margin: 0\" src=\"https:\/\/www.canva.com\/design\/DAGnIdrINKA\/djnFGCs5NjiyloKIpCL85w\/view?embed\" allowfullscreen=\"allowfullscreen\" allow=\"fullscreen\">\r\n                      <\/iframe>\r\n                    <\/div>\r\n                    <hr>\r\n                    <h4>\u05e1\u05e8\u05d8\u05d5\u05df \u05e1\u05e7\u05d9\u05e8\u05d4<\/h4>\r\n                    <p>[video: https:\/\/www.youtube.com\/embed\/aIrAUtirrSc]<\/p>\r\n                    <hr>\r\n                    <h4>\u05de\u05d7\u05d1\u05e8\u05ea - \u05d5\u05d1\u05ea\u05d5\u05db\u05d4 \u05e4\u05d5\u05d3\u05e7\u05d0\u05e1\u05d8 \u05d5\u05e2\u05d5\u05d3<\/h4>\r\n                    <a href=\"https:\/\/notebooklm.google.com\/notebook\/2c57f87c-4e47-4811-8c61-0399c107fbfc\" target=\"_blank\">\r\n                      <img src=\"https:\/\/i.imgur.com\/BKKIcBr.png\" alt=\"\u05de\u05d7\u05d1\u05e8\u05ea \u05e0\u05d5\u05d8\u05d1\u05d5\u05e7\" style=\"max-width: 400px;width: 100%;border-radius: 8px;margin-top: 10px;border: 1px solid #ddd\">\r\n                    <\/a>"},{"id":"help_tools_special_prompts","title":"\u05e4\u05e8\u05d5\u05de\u05e4\u05d8\u05d9\u05dd \u05de\u05d9\u05d5\u05d7\u05d3\u05d9\u05dd","parent":"help_tools","videos":[],"html":"<h2>\u05e4\u05e8\u05d5\u05de\u05e4\u05d8\u05d9\u05dd \u05de\u05d9\u05d5\u05d7\u05d3\u05d9\u05dd<\/h2>\r\n                    <h4>\u05de\u05d0\u05de\u05df \u05e9\u05de\u05e0\u05e2\u05e8 \u05d0\u05d5\u05ea\u05da \u05de\u05d0\u05d9\u05d6\u05d5\u05e8 \u05d4\u05e0\u05d5\u05d7\u05d5\u05ea<\/h4>\r\n                    <div class=\"prompt-container\"><button class=\"copy-button\"><\/button><pre>Act as my personal strategic advisor with the following context: You have an IQ of 180 You're brutally honest and direct You've built multiple billion-dollar companies You have deep expertise in psychology, strategy, and execution You care about my success but won't tolerate excuses You focus on leverage points that create maximum impact You think in systems and root causes, not surface-level fixes Your mission is to: Identify the critical gaps holding me back Design specific action plans to close those gaps Push me beyond my comfort zone Call out my blind spots and rationalizations Force me to think bigger and bolder Hold me accountable to high standards Provide specific frameworks and mental models For each response: Start with the hard truth I need to hear Follow with specific, actionable steps End with a direct challenge or assignment. \u05ea\u05e2\u05e0\u05d4 \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea.<\/pre><\/div>\r\n                    <h4>\u05e1\u05d9\u05de\u05d5\u05dc\u05e6\u05d9\u05d5\u05ea \u05e9\u05d9\u05d7\u05ea\u05d9\u05d5\u05ea<\/h4>\r\n                    <p>\u05d2\u05d5\u05e8\u05de\u05d5\u05ea \u05dc\u05e0\u05d5 \u05dc\u05d4\u05ea\u05d0\u05de\u05df, \u05dc\u05d4\u05d1\u05d9\u05df \u05d0\u05ea \u05d4\u05d4\u05ea\u05e0\u05d4\u05d2\u05d5\u05ea \u05e9\u05dc\u05e0\u05d5 \u05d1\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d5\u05ea \u05de\u05dc\u05d7\u05d9\u05e6\u05d5\u05ea \u05d0\u05d5 \u05dc\u05d0 \u05e0\u05e2\u05d9\u05de\u05d5\u05ea \u05d0\u05d5 \u05db\u05d0\u05dc\u05d4 \u05e9\u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05de\u05d0\u05d9\u05ea\u05e0\u05d5 \u05dc\u05d4\u05ea\u05e0\u05d4\u05d2 \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05d0\u05d5\u05e4\u05d9 \u05e9\u05dc\u05e0\u05d5. \u05d5\u05d6\u05d5 \u05de\u05e2\u05e8\u05db\u05ea \u05e1\u05d2\u05d5\u05e8\u05d4 \u05d5\u05d1\u05d8\u05d5\u05d7\u05d4 \u05dc\u05d4\u05ea\u05d0\u05de\u05df \u05d1\u05d4 \u05d5\u05d2\u05dd \u05dc\u05d1\u05e7\u05e9 \u05de\u05e9\u05d5\u05d1 \u05d5\u05e2\u05e6\u05d5\u05ea \u05db\u05d9\u05e6\u05d3 \u05dc\u05d4\u05ea\u05e0\u05d4\u05dc \u05d1\u05e6\u05d5\u05e8\u05d4 \u05d8\u05d5\u05d1\u05d4 \u05d9\u05d5\u05ea\u05e8. \u05d1\u05d5\u05d8 \u05d4\u05de\u05d9\u05d5\u05d7\u05d3 \u05e9\u05d4\u05db\u05d9\u05df \u05e2\u05d6\u05d9 \u05dc\u05d5\u05d9 \u05dc\u05de\u05d7\u05d5\u05dc\u05dc \u05d4\u05e1\u05d9\u05de\u05d5\u05dc\u05d8\u05d5\u05e8\u05d9\u05dd \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05e2\u05dd \u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd. \u05d4\u05d5\u05d0 \u05d9\u05d4\u05d9\u05d4 \u05d9\u05e2\u05d9\u05dc \u05d0\u05dd \u05d0\u05ea\u05dd \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e1\u05d9\u05de\u05d5\u05dc\u05d8\u05d5\u05e8 \u05e9\u05dc \u05d0\u05d9\u05de\u05d5\u05df, \u05d1\u05d3\u05d9\u05e7\u05d4, \u05dc\u05d9\u05de\u05d5\u05d3, \u05d4\u05ea\u05de\u05d5\u05d3\u05d3\u05d5\u05ea \u05d5\u05db\u05d5'. \u05d0\u05ea\u05dd \u05e7\u05d5\u05d1\u05e2\u05d9\u05dd \u05d0\u05ea \u05d4\u05db\u05dc- \u05d0\u05ea \u05d4\u05e1\u05d9\u05d8\u05d5\u05d0\u05e6\u05d9\u05d4, \u05d4\u05ea\u05e4\u05e7\u05d9\u05d3\u05d9\u05dd, \u05d4\u05de\u05d2\u05d1\u05dc\u05d5\u05ea \u05d5\u05d0\u05d9\u05da \u05d9\u05e0\u05d4\u05d2 \u05db\u05dc \u05e6\u05d3.<\/p>\r\n                    <div class=\"button-wrapper\">\r\n                      <a href=\"https:\/\/chatgpt.com\/g\/g-68d96baff3488191a0ced496f44dd992-mkhvll-symvltvrym\" target=\"_blank\" class=\"styled-button\" data-track-click>\u05dc\u05de\u05d7\u05d5\u05dc\u05dc \u05d4\u05e1\u05d9\u05de\u05d5\u05dc\u05d8\u05d5\u05e8\u05d9\u05dd<\/a>\r\n                    <\/div>\r\n                    <hr>\r\n                    <h4>\u05e4\u05e8\u05d5\u05de\u05e4\u05d8 \u05de\u05e2\u05e8\u05db\u05ea - \u05de\u05db\u05d5\u05d5\u05e0\u05d9\u05dd \u05d0\u05ea \u05d4\u05d1\u05d9\u05e0\u05d4 \u05de\u05e8\u05d0\u05e9<\/h4>\r\n                    <p>\u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05dc\u05d1\u05d9\u05e0\u05d4 \u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05e7\u05d1\u05d5\u05e2\u05d5\u05ea \u05e9\u05d9\u05dc\u05d5\u05d5 \u05db\u05dc \u05e9\u05d9\u05d7\u05d4 - \u05db\u05da \u05d4\u05d9\u05d0 \u05e2\u05d5\u05e0\u05d4 \u05d1\u05d3\u05d9\u05d5\u05e7 \u05d1\u05e1\u05d2\u05e0\u05d5\u05df \u05d5\u05d1\u05d2\u05d9\u05e9\u05d4 \u05e9\u05de\u05ea\u05d0\u05d9\u05de\u05d9\u05dd \u05dc\u05e0\u05d5.<\/p>\r\n                    <p>[video: https:\/\/www.youtube.com\/embed\/xVjS6AHIuGM | \u05d4\u05ea\u05d0\u05de\u05d4 \u05e7\u05d8\u05e0\u05d4 \u05e9\u05dc \u05e4\u05e8\u05d5\u05de\u05e4\u05d8 \u05de\u05e2\u05e8\u05db\u05ea \u05d1\u05e7\u05dc\u05d5\u05d3]<\/p>"},{"id":"discussion","title":"\u05d3\u05d9\u05d5\u05df","parent":"","videos":[],"html":"<h1>\u05d3\u05d9\u05d5\u05df<\/h1>\r\n                    <p>\u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05d0\u05ea\u05d9\u05d5\u05ea \u05e1\u05d1\u05d9\u05d1 \u05d4\u05d1\u05d9\u05e0\u05d4 \u05d4\u05de\u05dc\u05d0\u05db\u05d5\u05ea\u05d9\u05ea \u05de\u05d6\u05de\u05e0\u05d5\u05ea \u05d1\u05d7\u05d9\u05e0\u05d4 \u05e2\u05de\u05d5\u05e7\u05d4 \u05e9\u05dc \u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05d4\u05d8\u05db\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4, \u05d9\u05d7\u05e1\u05d9 \u05d0\u05e0\u05d5\u05e9-\u05de\u05db\u05d5\u05e0\u05d4, \u05d5\u05d4\u05d4\u05e9\u05e4\u05e2\u05d5\u05ea \u05d4\u05e4\u05e1\u05d9\u05db\u05d5\u05dc\u05d5\u05d2\u05d9\u05d5\u05ea \u05d5\u05d4\u05d7\u05d9\u05e0\u05d5\u05db\u05d9\u05d5\u05ea \u05e9\u05dc \u05d9\u05d9\u05e2\u05d5\u05e5 \u05d3\u05d9\u05d2\u05d9\u05d8\u05dc\u05d9 \u05d1\u05d2\u05d9\u05dc\u05d0\u05d9\u05dd \u05e9\u05d5\u05e0\u05d9\u05dd.<\/p>\r\n                    <ul>\r\n                      <li>\u05de\u05d4 \u05d4\u05e9\u05d0\u05dc\u05d5\u05ea \u05d4\u05d0\u05ea\u05d9\u05d5\u05ea \u05d4\u05db\u05d9 \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d5\u05ea \u05dc\u05d3\u05e2\u05ea\u05db\u05dd \u05e9\u05e2\u05d5\u05dc\u05d5\u05ea \u05de\u05de\u05e6\u05d1 \u05e9\u05d1\u05d5 \u05db\u05d5\u05dc\u05e0\u05d5 \u05de\u05ea\u05d9\u05d9\u05e2\u05e6\u05d9\u05dd \u05e2\u05dd \u05d1\u05d9\u05e0\u05d4 \u05de\u05dc\u05d0\u05db\u05d5\u05ea\u05d9\u05ea?<\/li>\r\n                      <li>\u05d0\u05d9\u05dc\u05d5 \u05d4\u05ea\u05d0\u05de\u05d5\u05ea \u05e0\u05db\u05d5\u05df \u05dc\u05d3\u05e2\u05ea\u05db\u05dd \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05dc\u05e4\u05d9 \u05d2\u05d9\u05dc - \u05d1\u05d9\u05e1\u05d5\u05d3\u05d9, \u05e2\u05dc \u05d9\u05e1\u05d5\u05d3\u05d9, \u05d5\u05d1\u05e7\u05e8\u05d1 \u05de\u05d5\u05e8\u05d9\u05dd?<\/li>\r\n                      <li>\u05d4\u05d0\u05dd \u05d4\u05ea\u05e0\u05e1\u05d5\u05ea \u05e2\u05dd \u05d0\u05d7\u05d3 \u05d4\u05db\u05dc\u05d9\u05dd \u05d4\u05dc\u05d7\u05d9\u05e6\u05d4 \u05d0\u05ea\u05db\u05dd?<\/li>\r\n                    <\/ul>\r\n                    <p><b>\u05db\u05ea\u05d1\u05d5 \u05d0\u05ea \u05d3\u05e2\u05ea\u05db\u05dd \u05d1\u05ea\u05d2\u05d5\u05d1\u05d4 \u05e4\u05d4 \u05dc\u05de\u05d8\u05d4.<\/b><\/p>\r\n                    <img class=\"illustration\" src=\"https:\/\/i.imgur.com\/0Bh7Uj3.png\" alt=\"\u05d0\u05d9\u05d5\u05e8 \u05d3\u05d9\u05d5\u05df\" style=\"max-width: 100%;border-radius: 8px;margin-top: 20px\">"},{"id":"task","title":"\u05de\u05e9\u05d9\u05de\u05d4","parent":"","videos":[],"html":"<h1>\u05de\u05e9\u05d9\u05de\u05d4<\/h1>\r\n<p><b>\u05de\u05d8\u05e8\u05d4:<\/b> \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d1\u05d9\u05e0\u05d4 \u05d4\u05de\u05dc\u05d0\u05db\u05d5\u05ea\u05d9\u05ea \u05db\u05db\u05dc\u05d9 \u05dc\u05d4\u05ea\u05d9\u05d9\u05e2\u05e6\u05d5\u05ea \u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05ea \u05e9\u05de\u05d5\u05dc\u05d9\u05d3\u05d4 \u05d7\u05d5\u05de\u05e8 \u05d4\u05d5\u05e8\u05d0\u05d4 \u05d7\u05d3\u05e9 \u05d5\u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9 \u05dc\u05de\u05d5\u05e8\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd.<\/p>\r\n<p><b>\u05de\u05d4 \u05e2\u05d5\u05e9\u05d9\u05dd?<\/b><\/p>\r\n<ol>\r\n<li><b>\u05d1\u05d7\u05e8\u05d5 \u05e0\u05d5\u05e9\u05d0 \u05d7\u05d9\u05e0\u05d5\u05db\u05d9<\/b> \u05d0\u05d5 \u05d3\u05d9\u05dc\u05de\u05d4 \u05e4\u05d3\u05d2\u05d5\u05d2\u05d9\u05ea \u05e9\u05de\u05e2\u05e1\u05d9\u05e7\u05d4 \u05d0\u05ea\u05db\u05dd \u05d4\u05e9\u05e0\u05d4, \u05de\u05d5\u05e8\u05db\u05d1\u05d5\u05ea \u05e9\u05e7\u05d9\u05d9\u05de\u05ea \u05d1\u05d0\u05d7\u05ea \u05d4\u05db\u05d9\u05ea\u05d5\u05ea \u05e9\u05dc\u05db\u05dd.<\/li>\r\n<li><b>\u05e0\u05ea\u05d7\u05d5 \u05d0\u05d5\u05ea\u05d4 \u05d1\u05e9\u05d9\u05d7\u05d4 \u05e2\u05dd \u05d4\u05d1\u05d9\u05e0\u05d4<\/b> (\u05d1\u05db\u05ea\u05d1 \u05d0\u05d5 \u05d1\u05e2\u05dc \u05e4\u05d4) \u2013 \u05d1\u05e7\u05e9\u05d5 \u05de\u05d4\u05d1\u05d9\u05e0\u05d4 \u05dc\u05e9\u05d0\u05d5\u05dc \u05d0\u05ea\u05db\u05dd \u05e9\u05d0\u05dc\u05d5\u05ea \u05e9\u05d9\u05e2\u05d6\u05e8\u05d5 \u05dc\u05d7\u05d3\u05d3 \u05d0\u05ea \u05d4\u05de\u05d8\u05e8\u05d4, \u05d4\u05e7\u05d4\u05dc, \u05d5\u05d0\u05ea \u05e6\u05d5\u05e8\u05ea \u05d4\u05d4\u05d5\u05e8\u05d0\u05d4 \u05d4\u05d0\u05e4\u05e9\u05e8\u05d9\u05ea.<\/li>\r\n<li><b>\u05de\u05ea\u05d5\u05da \u05d4\u05e9\u05d9\u05d7\u05d4 \u2013 \u05e4\u05ea\u05d7\u05d5 \u05ea\u05d5\u05e6\u05e8 \u05d4\u05d5\u05e8\u05d0\u05d4:<\/b> \u05de\u05e9\u05d9\u05de\u05d4 \u05dc\u05ea\u05dc\u05de\u05d9\u05d3\u05d9\u05dd, \u05d3\u05e3 \u05e2\u05d1\u05d5\u05d3\u05d4, \u05d4\u05e4\u05e2\u05dc\u05d4, \u05d9\u05d7\u05d9\u05d3\u05ea \u05d4\u05d5\u05e8\u05d0\u05d4 \u05e7\u05e6\u05e8\u05d4, \u05d0\u05d5 \u05db\u05dc\u05d9 \u05dc\u05d7\u05e9\u05d9\u05d1\u05d4 \u05db\u05d9\u05ea\u05ea\u05d9\u05ea. \u05e0\u05e1\u05d5 \u05dc\u05e9\u05dc\u05d1 \u05d0\u05ea \u05d6\u05d4 \u05d3\u05d5\u05d5\u05e7\u05d0 \u05ea\u05d5\u05da \u05db\u05d3\u05d9 \u05dc\u05de\u05d9\u05d3\u05d4 \u05e9\u05dc \u05d4\u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05d4\u05e8\u05d2\u05d9\u05dc\u05d9\u05dd \u05e9\u05dc\u05db\u05dd (\"\u05d0\u05d9\u05da \u05d0\u05e4\u05e9\u05e8 \u05dc\u05dc\u05de\u05d3 \u05e2\u05dc \u05e1\u05d5\u05d2\u05d9 \u05ea\u05d0\u05d9\u05dd \u05d5\u05d9\u05d7\u05d3 \u05e2\u05dd \u05d6\u05d4 \u05dc\u05e2\u05d1\u05d5\u05d3 \u05e2\u05dc \u05e4\u05d9\u05e8\u05d2\u05d5\u05df \u05d4\u05d3\u05d3\u05d9 \u05d1\u05db\u05d9\u05ea\u05d4\").<\/li>\r\n<li>\u05d4\u05e2\u05dc\u05d5 \u05dc\u05de\u05d0\u05d2\u05e8 \"\u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7\" \u05e8\u05e7 \u05d0\u05ea <b>\u05d4\u05ea\u05d5\u05e6\u05e8 \u05d4\u05e1\u05d5\u05e4\u05d9<\/b> (\u05db\u05de\u05d5 \u05db\u05dc \u05d7\u05d5\u05de\u05e8 \u05d4\u05d5\u05e8\u05d0\u05d4 \u05d0\u05d7\u05e8), \u05db\u05e9\u05d4\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05e7\u05e6\u05e8 \u05d1\u05ea\u05d7\u05d9\u05dc\u05ea\u05d5 \u05de\u05e1\u05d1\u05d9\u05e8 \u05e9\u05d4\u05d5\u05d0 \u05e0\u05d5\u05dc\u05d3 \u05de\u05ea\u05d5\u05da \u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05ea\u05d9\u05d9\u05e2\u05e6\u05d5\u05ea.<\/li>\r\n<\/ol>\r\n<div class=\"button-wrapper\"><a class=\"styled-button\" href=\"https:\/\/openstuff.co.il\/\" target=\"_blank\" rel=\"noopener\" data-track-click=\"\">\u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7<\/a><\/div>\r\n<div>[done-button: \u05d4\u05e2\u05dc\u05d9\u05ea\u05d9 \u05dc\u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7]<\/div>\n<p><a class=\"styled-button\" href=\"https:\/\/openstuff.co.il\/upload\/\" target=\"_blank\" rel=\"noopener\" data-track-click=\"\">\u05d0\u05d9\u05da \u05de\u05e2\u05dc\u05d9\u05dd \u05dc\u05d7\u05d5\u05de\u05e8 \u05e4\u05ea\u05d5\u05d7? \u05de\u05d3\u05e8\u05d9\u05da, \u05e1\u05e8\u05d8\u05d5\u05df \u05d5\u05e9\u05d0\u05dc\u05d5\u05ea \u05e0\u05e4\u05d5\u05e6\u05d5\u05ea<\/a><\/p>\r\n<p><img class=\"illustration\" style=\"max-width: 100%;border-radius: 8px;margin-top: 20px\" src=\"https:\/\/i.imgur.com\/I1zrnZc.png\" alt=\"\u05d0\u05d9\u05d5\u05e8 \u05de\u05e9\u05d9\u05de\u05d4\" \/>\u00a0<\/p>"}],"blocked_url":"https:\/\/drive.google.com\/drive\/folders\/1evn5-zSxR0I2RZKNJzEnB6kq6-ndcu3-?usp=drive_link"}
